# ==========================================
# Les Principes Retrouvés — variables de déploiement (racine)
# Copier ce fichier en ".env" et adapter les valeurs.
# Consommé par docker-compose.yml (app Next.js derrière Traefik).
# ==========================================

# ── Traefik / conteneurs ──────────────────────────────────────
# Nom du projet (préfixe des conteneurs/images). Vide = nom du dossier.
COMPOSE_PROJECT_NAME=principes-retrouves

# Domaine public servi par Traefik (LE réglage à changer par instance)
SITE_HOST=les-principes-retrouves.webtinix.com

# Nom unique du routeur Traefik (évite les collisions entre instances)
# Ex : preprod, prod, demo-client
TRAEFIK_CONFIG_NAME=les-principes-retrouves

# Fuseau horaire du conteneur
TZ=Africa/Brazzaville

# ── Application Next.js ───────────────────────────────────────
# URL publique du site (SEO / liens absolus)
NEXT_PUBLIC_SITE_URL=https://les-principes-retrouves.webtinix.com

# Base de données
#   DEV / Lot 0-3 : SQLite     → file:./dev.db (éphémère en conteneur)
#   PROD / Lot 4+ : PostgreSQL → postgresql://USER:PASSWORD@db:5432/DBNAME?schema=public
DATABASE_URL=file:./dev.db

# Fournisseur de paiement : "mock" (défaut, sans clés) ou "cinetpay" (Lot 4)
PAYMENT_PROVIDER=mock

# ── Renseignés plus tard (placeholders — cf. ROADMAP.md) ──────
# PostgreSQL (activer au Lot 4 — décommenter le service db du compose)
# POSTGRES_USER=brazzaville
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=principes_retrouves

# Paiement CinetPay (Lot 4 — compte marchand fourni ultérieurement)
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=

# Formulaire de contact (Lot 3)
# CONTACT_INBOX_EMAIL=
# MAIL_API_KEY=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
