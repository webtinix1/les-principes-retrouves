# ==========================================
# Les Principes Retrouvés — variables de déploiement (racine)
# Copier ce fichier en ".env" et adapter les valeurs.
# Consommé par docker-compose.yml (app Next.js derrière Traefik).
# ==========================================

# ── Traefik / conteneurs ──────────────────────────────────────
# Nom du projet (préfixe des conteneurs/images). Vide = nom du dossier.
COMPOSE_PROJECT_NAME=principes-retrouves

# Domaine public servi par Traefik (LE réglage à changer par instance)
SITE_HOST=les-principes-retrouves.webtinix.com

# Nom unique du routeur Traefik (évite les collisions entre instances)
# Ex : preprod, prod, demo-client
TRAEFIK_CONFIG_NAME=les-principes-retrouves

# Fuseau horaire du conteneur
TZ=Africa/Brazzaville

# ── Application Next.js ───────────────────────────────────────
# URL publique du site (SEO / liens absolus)
NEXT_PUBLIC_SITE_URL=https://les-principes-retrouves.webtinix.com

# ── Base de données (PostgreSQL, service "db" du compose) ─────
# DATABASE_URL est construite par docker-compose.yml à partir de ces valeurs.
POSTGRES_USER=brazzaville
POSTGRES_PASSWORD=change-me
POSTGRES_DB=principes_retrouves

# ── Back-office Payload CMS (/admin) ──────────────────────────
# Clé de chiffrement des sessions : longue et aléatoire, ne JAMAIS la changer
# après la mise en service (déconnecte tout le monde). Générer :
#   openssl rand -hex 32
PAYLOAD_SECRET=
# Premier compte administrateur, créé au démarrage s'il n'existe aucun compte.
# Les comptes se gèrent ensuite dans /admin → Utilisateurs (on peut vider ces lignes).
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Paiement CinetPay (Lot 4 — compte marchand fourni ultérieurement)
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=

# Formulaire de contact (Lot 3) — laissés vides = mode dégradé (le message est
# tout de même enregistré en base ; l'e-mail et l'anti-spam s'activent une fois renseignés).
#   Anti-spam Cloudflare Turnstile :
#   - NEXT_PUBLIC_TURNSTILE_SITE_KEY est lue au BUILD (à passer en build-arg pour l'embarquer).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
#   E-mail transactionnel (Resend) — le domaine du "from" doit être vérifié chez Resend.
CONTACT_INBOX_EMAIL=
RESEND_API_KEY=
RESEND_FROM=

# Back-office /admin — Payload a sa propre authentification ; Traefik ajoute en
# plus un basic-auth sur /admin (double verrou). Obligatoire tant que le router
# "admin-…" du docker-compose.yml est conservé.
#   Générer un couple identifiant/mot de passe :
#     openssl passwd -apr1 "VOTRE_MOT_DE_PASSE"
#   puis composer "utilisateur:hash" et DOUBLER chaque "$" en "$$" (échappement compose).
#   Exemple de forme (NE PAS réutiliser tel quel) :
#     ADMIN_BASIC_AUTH=admin:$$apr1$$xxxxxxxx$$xxxxxxxxxxxxxxxxxxxxxx
ADMIN_BASIC_AUTH=

# Paiement — fournisseur actif : "mock" (défaut), "chariow" ou "cinetpay".
PAYMENT_PROVIDER=mock

# Chariow (recommandé — checkout hébergé, Mobile Money + carte).
#   Clé serveur (dashboard → Settings → API) :
CHARIOW_API_KEY=
#   Secret de signature des webhooks (si fourni par Chariow) :
CHARIOW_WEBHOOK_SECRET=
#   Mapping module → produit Chariow (JSON) : créer les produits dans le dashboard,
#   puis renseigner leurs identifiants par régime tarifaire.
#   CHARIOW_PRODUCT_MAP={"fondements_organon":{"b2b":"prd_xxx","b2c":"prd_yyy"},"laboratoire_proactivite_juridique":{"b2b":"prd_zzz","b2c":"prd_www"}}
CHARIOW_PRODUCT_MAP=

# CinetPay (repli éventuel — non retenu).
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
