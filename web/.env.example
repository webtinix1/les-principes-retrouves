# ─────────────────────────────────────────────────────────────
# Variables d'environnement — Portail École de Brazzaville (web/)
# Copier en `.env` et renseigner. NE JAMAIS committer de secret réel.
# ─────────────────────────────────────────────────────────────

# Base de données
#   DEV  : SQLite      → file:./dev.db
#   PROD : PostgreSQL  → postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="file:./dev.db"

# ── Renseignés plus tard (placeholders — cf. ROADMAP.md) ──────

# Paiement CinetPay (Lot 4) — compte marchand fourni ultérieurement
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
# Fournisseur de paiement actif : "mock" (défaut, sans clés) ou "cinetpay"
PAYMENT_PROVIDER="mock"

# Formulaire de contact (Lot 3)
CONTACT_INBOX_EMAIL=""
MAIL_API_KEY=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
