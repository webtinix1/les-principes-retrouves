# ─────────────────────────────────────────────────────────────
# Variables d'environnement — Portail École de Brazzaville (web/)
# Copier en `.env` et renseigner. NE JAMAIS committer de secret réel.
# ─────────────────────────────────────────────────────────────

# Base PostgreSQL du back-office Payload (en dev, le schéma est synchronisé
# automatiquement ; en production, les migrations de migrations/ s'appliquent).
DATABASE_URL="postgresql://payload:payload@127.0.0.1:5432/principes"

# Clé de chiffrement des sessions du back-office (openssl rand -hex 32)
PAYLOAD_SECRET=""

# Premier compte administrateur (créé seulement si aucun compte n'existe)
PAYLOAD_ADMIN_EMAIL="admin@example.com"
PAYLOAD_ADMIN_PASSWORD=""

# Dossier des PDF protégés téléversés (défaut : protected/documents)
# DOCUMENTS_DIR=""

# Fournisseur de paiement actif : "mock" (défaut, sans clés), "chariow" ou "cinetpay"
PAYMENT_PROVIDER="mock"
CHARIOW_API_KEY=""
CHARIOW_WEBHOOK_SECRET=""
CHARIOW_PRODUCT_MAP=""

# Formulaire de contact
CONTACT_INBOX_EMAIL=""
RESEND_API_KEY=""
RESEND_FROM=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
