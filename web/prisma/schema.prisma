// Schéma Prisma — Portail de l'École de Brazzaville
// Doc : https://pris.ly/d/prisma-schema
//
// DEV  : SQLite (provider "sqlite", DATABASE_URL="file:./dev.db").
// PROD : PostgreSQL (conteneur Docker, cf. CADRAGE-V2.md §4ter).
//        → passer provider = "postgresql" + DATABASE_URL postgres://…
//
// Aucun modèle métier pour l'instant (Lot 0). Les modèles Order / AccessCode /
// Enrollment / ContactMessage arrivent aux Lots 3-5 (champs en snake_case).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// NB (Prisma 7) : l'URL de connexion vit dans prisma.config.ts, plus ici.
datasource db {
  provider = "sqlite"
}

/// Message reçu via le formulaire de contact (Secrétariat International).
/// Champs en snake_case (règle d'or CLAUDE.md).
model ContactMessage {
  id            String   @id @default(cuid())
  created_at    DateTime @default(now())
  nom           String
  email         String
  organisation  String?
  sujet         String
  message       String
  consent_rgpd  Boolean  @default(false)
  statut        String   @default("nouveau") // nouveau | traite | archive
  source        String   @default("site")
}

/// Commande d'un module de formation (achat invité, sans compte).
/// Conserve les infos acheteur = historique (Lot 4).
model Commande {
  id                 String     @id @default(cuid())
  created_at         DateTime   @default(now())
  module_id          String
  module_titre       String
  tarif_type         String // b2b | b2c | devis
  montant            String // libellé affiché ("800 €")
  devise             String     @default("EUR")
  buyer_nom          String
  buyer_email        String
  buyer_organisation String?
  buyer_telephone    String?
  buyer_pays         String? // code pays ISO (ex. CG)
  payment_provider   String     @default("mock")
  payment_ref        String?
  statut             String     @default("en_attente") // en_attente | paye | echoue | rembourse | devis_demande
  code_acces         CodeAcces?
}

/// Code d'accès émis après paiement, débloquant les téléchargements (Lot 5).
model CodeAcces {
  id          String    @id @default(cuid())
  code        String    @unique
  created_at  DateTime  @default(now())
  niveau      String // module_i | module_ii | module_iii
  email       String
  commande_id String    @unique
  commande    Commande  @relation(fields: [commande_id], references: [id], onDelete: Cascade)
  expires_at  DateTime?
  revoked     Boolean   @default(false)
  used_at     DateTime?
}

/// Disponibilité d'une ressource téléchargeable (Working Paper, guide…),
/// pilotée depuis le back-office. Consommée par le gating du Lot 5.
model RessourceEtat {
  ressource_id String   @id
  is_available Boolean  @default(false)
  updated_at   DateTime @updatedAt
}

/// Surcharge éditoriale d'un bloc de contenu, pilotée depuis le back-office.
/// Le CODE reste la source par défaut (registre `content/blocs/`) : une ligne
/// ici signifie « ce bloc a été réécrit depuis /admin/contenu ». Supprimer la
/// ligne = revenir au texte d'origine. Valeur = fragment HTML assaini serveur.
model ContenuBloc {
  cle        String   @id
  valeur     String
  updated_at DateTime @updatedAt
}

/// Historique des versions d'un bloc (restauration depuis le back-office).
/// Volontairement SANS relation vers ContenuBloc : l'historique doit survivre
/// à un retour au texte d'origine (qui supprime la surcharge).
model ContenuBlocVersion {
  id         String   @id @default(cuid())
  cle        String
  valeur     String
  created_at DateTime @default(now())

  @@index([cle, created_at])
}
